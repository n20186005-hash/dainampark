---
import '../../styles/global.css';
import BaseHead from '../../components/BaseHead.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const canonical = 'https://dainampark.com/en/privacy';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      lang="en"
      title="Privacy Policy | Dai Nam Visitor Guide"
      description="Privacy policy for the independent Dai Nam visitor guide: analytics consent, external links and cookies."
      canonical={canonical}
    />
  </head>
  <body class="bg-[#fffaf0] text-[#17352f]">
    <main class="section-shell py-16">
      <a href="/en/" class="underline">← Home</a>
      <h1 class="mt-8 text-4xl font-bold">Privacy Policy</h1>
      <div class="mt-8 max-w-3xl space-y-5 leading-7 text-slate-700">
        <p>This guide is an independent website. It does not require login and does not operate a user database.</p>
        <p>Google Analytics 4 is loaded only after visitors accept measurement cookies. Users may decline or change the choice at any time in Cookie settings.</p>
        <p>External links, Google Maps and third-party websites are governed by their own providers' policies.</p>
        <p>Updated: 18/09/2026.</p>
      </div>
    </main>
    <SiteFooter lang="en" />
  </body>
</html>
