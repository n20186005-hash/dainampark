        <div class="mt-4 flex shrink-0 gap-2 sm:mt-0"><button id="cookie-decline" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-bold">Từ chối</button><button id="cookie-accept" class="rounded-full bg-[#0e6a58] px-4 py-2 text-sm font-bold text-white">Đồng ý</button></div>
