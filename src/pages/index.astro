        <div class="flex items-start justify-between gap-5"><div><p class="kicker">Cookie</p><h2 class="mt-2 text-3xl font-bold">Tùy chọn đo lường</h2></div><button id="cookie-close" class="text-2xl" aria-label="Đóng">×</button></div>
        <div class="mt-6 flex items-center justify-between gap-5 rounded-2xl bg-[#e9f2ee] p-4"><div><b>Google Analytics 4</b><p class="mt-1 text-xs leading-5 text-slate-600">Giúp hiểu cách người dùng tương tác với trang. Chỉ bật khi bạn đồng ý.</p></div><input id="analytics-toggle" type="checkbox" class="h-5 w-5 accent-[#0e6a58]" /></div>
        <button id="cookie-save" class="mt-5 w-full rounded-full bg-[#0e6a58] px-4 py-3 font-bold text-white">Lưu lựa chọn</button>
      </div>
    </div>

    <script is:inline>
      (() => {
        const consentKey = 'daiNamAnalyticsConsent';
        const banner = document.getElementById('cookie-banner');
        const settings = document.getElementById('cookie-settings');
        const toggle = document.getElementById('analytics-toggle');
        let gaLoaded = false;

        function loadGA() {
          if (gaLoaded) return;
          gaLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';
          s.dataset.consentLoaded = 'true';
          document.head.appendChild(s);
        }

        function apply(value) {
          localStorage.setItem(consentKey, value);
          if (value === 'granted') loadGA();
          if (banner) banner.hidden = true;
          if (settings) settings.hidden = true;
          if (toggle) toggle.checked = value === 'granted';
        }

        const saved = localStorage.getItem(consentKey);
        if (!saved) {
          if (banner) banner.hidden = false;
        } else if (saved === 'granted') {
          loadGA();
          if (toggle) toggle.checked = true;
        }

        document.getElementById('cookie-accept')?.addEventListener('click', () => apply('granted'));
        document.getElementById('cookie-decline')?.addEventListener('click', () => apply('denied'));
        document.getElementById('open-cookie-settings')?.addEventListener('click', () => {
          if (toggle) toggle.checked = localStorage.getItem(consentKey) === 'granted';
          if (settings) settings.hidden = false;
        });
        document.getElementById('cookie-close')?.addEventListener('click', () => { if (settings) settings.hidden = true; });
        document.getElementById('cookie-save')?.addEventListener('click', () => apply(toggle?.checked ? 'granted' : 'denied'));
      })();
    </script>
