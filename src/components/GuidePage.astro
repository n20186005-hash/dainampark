---
import '../styles/global.css';import BaseHead from './BaseHead.astro';import SiteFooter from './SiteFooter.astro';import{SITE,MAPS,OPERATOR,ADDRESS,paths,labels,sources,text,type Locale,type Kind}from'../data/guide';
const{lang,kind='home'}=Astro.props as{lang:Locale;kind:Kind};const vi=lang==='vi',t=text[lang],other=vi?'en':'vi';const normalKinds:Kind[]=['home','hours','tickets','directions'];const canonical=SITE+paths[kind][lang];const title=kind==='home'?t.title:labels[lang][kind]+' — '+(vi?'Khu du lịch Đại Nam':'Dai Nam Park');const description=kind==='hours'?t.hours:kind==='tickets'?t.fees:kind==='directions'?t.address:kind==='privacy'?(vi?'Cách quản lý Google Analytics tùy chọn, cookie và dữ liệu của nền tảng lưu trữ.':'How optional Google Analytics, cookies and hosting data are handled.'):kind==='terms'?(vi?'Phạm vi của cẩm nang độc lập và giới hạn của thông tin có ngày đối chiếu.':'Scope of this independent guide and the limits of dated visitor information.'):t.intro;
const faq=kind==='home'?[{q:vi?'Đại Nam nằm ở đâu?':'Where is Dai Nam?',a:t.address},{q:vi?'Giờ hoạt động đã được xác nhận chưa?':'Are current hours confirmed?',a:t.hours},{q:vi?'Vé vào cổng có bao gồm mọi phân khu không?':'Does gate admission cover every zone?',a:t.fees},{q:vi?'Toàn tuyến có hỗ trợ tiếp cận không?':'Is the whole visit accessible?',a:t.access},{q:vi?'Đánh giá có tự động cập nhật không?':'Does the rating update automatically?',a:t.snapshot}]:kind==='hours'?[{q:vi?'Maps ghi17:00 có phải giờ cố định không?':'Is Maps’17:00 closing a fixed schedule?',a:t.hours},{q:vi?'Vì sao các nguồn có giờ khác nhau?':'Why do sources show different times?',a:vi?'Cổng du lịch ghi09:59–23:45; WTC ghi08:00–17:00 hằng ngày. Không nguồn nào trong hai trang là thông báo vận hành có ngày áp dụng cho từng phân khu; cần xác nhận lại.':'The tourism portal lists09:59–23:45 while WTC lists08:00–17:00 daily. Neither page is a dated operating notice for each zone; confirm directly.'}]:kind==='tickets'?[{q:vi?'Hiện tại có miễn phí vé vào cổng không?':'Is gate admission currently free?',a:t.fees},{q:vi?'Giá tour có phải giá vé cổng không?':'Is a tour price the gate ticket price?',a:vi?'Không mặc định như vậy. Hãy hỏi riêng vé cổng, dịch vụ, điều kiện khuyến mãi, độ tuổi/chiều cao và chính sách đổi trả trước khi mua.':'Do not assume so. Ask separately about gate admission, services, promotion terms, age/height eligibility and cancellation conditions before paying.'}]:kind==='directions'?[{q:vi?'Dùng địa chỉ nào để đến Đại Nam?':'Which address should I use?',a:t.address},{q:vi?'Đại Nam đã chuyển sang TP.HCM ở địa điểm khác?':'Did Dai Nam move to another site in HCMC?',a:t.admin},{q:vi?'Có đảm bảo tuyến không có bậc không?':'Is step-free access guaranteed?',a:t.access}]:[];
const clean=(s:string)=>s.replace(/([A-Za-zÀ-ỹ’])(?=\d)/g,'$1 ').replace(/là(?=\d)/g,'là ').replace(/lists(?=\d)/g,'lists ');for(const x of faq){x.q=clean(x.q);x.a=clean(x.a);}
const schema:Record<string,unknown>[]=[{'@context':'https://schema.org','@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,about:{'@type':'TouristAttraction','@id':SITE+'/#place',name:'Khu du lịch Đại Nam',address:{'@type':'PostalAddress',addressLocality:'Phường Phú An',addressRegion:'Thành phố Hồ Chí Minh',addressCountry:'VN'}}}];if(faq.length)schema.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(x=>({'@type':'Question',name:x.q,acceptedAnswer:{'@type':'Answer',text:x.a}}))});
---
<!doctype html><html lang={lang}><head><BaseHead lang={lang} title={title} description={description} canonical={canonical} ogImage={SITE+'/images/elephant-social.jpg'} imageAlt={t.photo} schema={schema} hreflangs={[{lang:'vi',href:SITE+paths[kind].vi},{lang:'en',href:SITE+paths[kind].en},{lang:'x-default',href:SITE+paths[kind].vi}]}/></head><body>
<a class="skip-link" href="#main">{vi?'Đến nội dung':'Skip to content'}</a><header class="guide-header"><div class="section-shell header-row"><a href={paths.home[lang]}><img src="/brand/logo.svg" width="340" height="88" alt={vi?'Đại Nam — Cẩm nang tham quan':'Dai Nam — Visitor guide'}/></a><nav class="desktop-nav" aria-label={t.menu}>{normalKinds.map(k=><a href={paths[k][lang]} aria-current={k===kind?'page':undefined}>{labels[lang][k]}</a>)}</nav><a class="language-link" href={paths[kind][other]} hreflang={other}>{vi?'English':'Tiếng Việt'}</a><details class="guide-menu"><summary>{t.menu}</summary><nav aria-label={t.menu}>{normalKinds.map(k=><a href={paths[k][lang]}>{labels[lang][k]}</a>)}</nav></details></div></header>
<main id="main"><section class="guide-hero"><div class="section-shell"><p class="eyebrow">{vi?'Cẩm nang độc lập · Phú An, TP.HCM':'Independent guide · Phú An, HCMC'}</p><h1>{title}</h1><p>{kind==='home'?t.intro:description}</p><div class="hero-actions"><a class="btn-primary" href={OPERATOR} target="_blank" rel="noopener noreferrer">{t.operator} ↗</a><a class="btn-ghost" href={MAPS} target="_blank" rel="noopener noreferrer">Google Maps ↗</a></div></div></section>
<p class="illustration-note">{t.diagram} · 2026 · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a></p>
{kind==='home'&&<><section class="guide-section section-shell"><div class="guide-grid"><div><h2>{vi?'Phân biệt các phân khu trước khi chọn vé':'Choose zones before choosing tickets'}</h2><p>{vi?'Trang chủ đơn vị vận hành giới thiệu đền thờ, biển nhân tạo, trường đua và vườn bách thú. Danh mục này mô tả loại hình của khu du lịch, không xác nhận mọi dịch vụ mở trong ngày bạn đến.':'The operator advertises the temple, artificial sea, racecourse and zoo. This describes the complex, not confirmation that every service opens on your chosen day.'}</p><div class="info-cards">{[{name:vi?'Kim Điện và đền thờ':'Kim Điện and temple',url:'https://khudulichdainam.com.vn/den-tho',body:t.courtesy},{name:vi?'Biển nhân tạo và trò chơi':'Artificial sea and rides',url:'https://khudulichdainam.com.vn/bien-nhan-tao',body:vi?'Hỏi riêng thời gian nhận khách, hạn chế chiều cao/tuổi, đồ bơi và quy định an toàn. Không suy ra hoạt động dưới nước được bao gồm trong vé cổng.':'Ask about admission cut-offs, age/height limits, swimwear and safety rules. Water activities are not assumed to be included in gate admission.'},{name:vi?'Vườn bách thú':'Zoo',url:'https://khudulichdainam.com.vn/vuon-bach-thu',body:vi?'Xác nhận khu trưng bày hiện mở và quy định quan sát. Không cho ăn hoặc vượt rào; ảnh lịch sử không phải danh sách động vật hiện có.':'Confirm operating exhibits and viewing rules. Do not feed animals or cross barriers; historical photographs are not a current animal inventory.'}].map(c=><article class="card"><h3><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name} ↗</a></h3><p>{c.body}</p></article>)}</div></div><figure class="archive-photo"><img src="/images/dai-nam-voi.jpg" width="1600" height="1200" alt={t.photo} loading="lazy"/><figcaption>{t.photo}{' '}<a href="https://commons.wikimedia.org/wiki/File:Voi_t%E1%BA%A1i_B%C3%ACnh_D%C6%B0%C6%A1ng.jpg">Bùi Thụy Đào Nguyên</a> · 2011-06-14 · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>. {vi?'Bản địa phương đã giảm kích thước/nén; không có chứng thực của tác giả.':'Local copy resized/recompressed; no endorsement implied.'}</figcaption></figure></div></section><section class="guide-section soft"><div class="section-shell guide-grid"><article><h2>{vi?'Địa chỉ hiện tại và nhãn cũ':'Current address and older labels'}</h2><p>{t.address}</p><p>{t.admin}</p><a class="text-link" href={paths.directions[lang]}>{labels[lang].directions} →</a></article><article><h2>{vi?'Trước ngày đi':'Before travelling'}</h2><p>{t.weather}</p><p>{t.access}</p><a href="https://nchmf.gov.vn/" class="text-link">{vi?'Dự báo và cảnh báo chính thức':'Official forecasts and warnings'} ↗</a></article></div></section><section class="guide-section section-shell"><h2>{vi?'Đánh giá trên Maps':'Maps rating snapshot'}</h2><p>{t.snapshot}</p></section></>}
{kind==='hours'&&<section class="guide-section section-shell narrow"><h2>{vi?'Ba thông tin khác nhau, chưa phải lịch vận hành':'Different listings do not establish an operating schedule'}</h2><div class="table-scroll"><table><thead><tr><th>{vi?'Nguồn':'Source'}</th><th>{vi?'Thông tin ghi trên trang':'Displayed information'}</th><th>{vi?'Giới hạn':'Limit'}</th></tr></thead><tbody><tr><td>Google Maps</td><td>2026-10-30 · 17:00</td><td>{vi?'Ảnh chụp giờ đóng cửa trong lần kiểm tra':'Closing-time snapshot from that check'}</td></tr><tr><td><a href="https://wtcbinhduong.vn/ke-hoach-tham-quan/khu-du-lich-dai-nam-2/">WTC</a></td><td>08:00–17:00</td><td>{vi?'Danh mục thứ cấp, không phải thông báo có ngày áp dụng của đơn vị vận hành':'Secondary listing, not a dated operator notice'}</td></tr><tr><td><a href="https://tourism.binhduong.gov.vn/vi/khudulichdainam">{vi?'Cổng du lịch':'Tourism portal'}</a></td><td>09:59–23:45</td><td>{vi?'Trường dữ liệu mâu thuẫn, không dùng để lên lịch':'Conflicting field, not used for visit planning'}</td></tr></tbody></table></div><p>{vi?'Bài giới thiệu biển nhân tạo trên website đơn vị vận hành mang ngày 06/10/2021 và vẫn có bảng giờ/giá cũ. Bảng này không được dùng làm lịch hiện hành năm 2026 cho toàn khu.':'The operator’s artificial-sea article is dated 6 October 2021 and still contains an older hours/price table. It is not used here as the complex’s confirmed 2026 schedule.'}{' '}<a href="https://khudulichdainam.com.vn/bien-nhan-tao">{vi?'Xem bài có ngày đăng':'View dated article'} ↗</a></p><h2>{vi?'Cần hỏi theo từng dịch vụ':'Ask separately for each service'}</h2><p>{vi?'Hỏi ngày mở cửa của đúng phân khu, thời gian bán vé/nhận khách cuối cùng và giờ rời khu. Không giả định biển, vườn thú, trò chơi hay trường đua theo cùng giờ cổng.':'Ask for the exact zone’s operating dates, last ticket sales/admission and departure deadline. The artificial sea, zoo, rides and racecourse need not share the main gate’s schedule.'}</p><p>{t.weather}</p><p>{vi?'Trang lịch biểu diễn của đơn vị vận hành còn hiển thị một thông báo dịch cũ khi kiểm tra; điều đó không xác nhận tình trạng đóng cửa hiện nay.':'The operator’s performance-calendar page still displayed an older pandemic notice when checked; that does not establish a current closure.'}</p></section>}
{kind==='tickets'&&<section class="guide-section section-shell narrow"><h2>{vi?'Một giá không nhất thiết bao gồm mọi trải nghiệm':'A single price need not cover the whole complex'}</h2><p>{vi?'Yêu cầu đơn vị bán liệt kê rõ vé cổng, khu được sử dụng, dịch vụ vận chuyển, gửi xe và điều kiện áp dụng. Nếu báo giá theo trẻ em, kiểm tra tiêu chí tuổi/chiều cao; không áp dụng bảng giá cũ cho ngày khác.':'Ask the seller to identify gate admission, included zones, transport, parking and eligibility conditions. For child pricing, verify age/height criteria; do not transfer an older tariff to another date.'}</p><div class="info-cards"><article class="card"><h3>{vi?'Khuyến mãi':'Promotions'}</h3><p>{vi?'Trang khuyến mãi chính thức có mục miễn vé cổng cho thiếu nhi nhưng không xác lập giá hiện hành cho tất cả khách hoặc mọi phân khu. Xác nhận ngày, điều kiện và phần loại trừ.':'The official promotions page includes a children’s gate-admission offer, but does not establish current prices for all visitors or every zone. Confirm dates, eligibility and exclusions.'}</p><a href="https://khudulichdainam.com.vn/khuyen-mai">{vi?'Xem chương trình, kiểm tra lại hiệu lực':'View offers and confirm validity'} ↗</a></article><article class="card"><h3>{vi?'Trước khi thanh toán':'Before payment'}</h3><p>{vi?'Kiểm tra đúng đơn vị bán, ngày sử dụng, loại vé, chính sách đổi trả và dịch vụ kèm theo. Cẩm nang này không nhận thanh toán, đặt chỗ hoặc thông tin thẻ.':'Verify the seller, date, ticket type, cancellation terms and included services. This guide does not take payments, reservations or card details.'}</p></article></div><p>{vi?'Giá tham khảo của WTC và bảng trong bài biển nhân tạo ngày 06/10/2021 không được chép thành giá hiện hành; chưa xác nhận được biểu giá đang áp dụng.':'WTC’s indicative prices and the table in the operator’s 6 October 2021 artificial-sea article are not reproduced as current tariffs; an applicable current price list remains unconfirmed.'}</p></section>}
{kind==='directions'&&<section class="guide-section section-shell narrow"><h2>{vi?'Đối chiếu địa chỉ trước khi đặt xe':'Check the address before booking transport'}</h2><p class="address-line">{ADDRESS}</p><p>{t.admin}</p><p>{vi?'Nhãn Bình Dương vẫn xuất hiện trong tài liệu cũ và tên Đại lộ Bình Dương vẫn là tên đường. Không hiểu các nhãn này là hai khu du lịch khác nhau.':'Bình Dương remains in older documents and Đại lộ Bình Dương remains the road name. These labels do not imply two different attractions.'}</p><div class="info-cards"><article class="card"><h3>{vi?'Xe cá nhân hoặc xe đặt trước':'Private or booked vehicle'}</h3><p>{vi?'Xác nhận cổng nhận khách, điểm hẹn về và điều kiện gửi xe. Chưa xác minh số chỗ, giá gửi hoặc thời gian lái xe; không hứa tuyến luôn thuận tiện.':'Confirm the visitor gate, return meeting point and parking terms. Spaces, parking prices and driving times were not verified; no universally easy route is promised.'}</p></article><article class="card"><h3>{vi?'Giao thông công cộng':'Public transport'}</h3><p>{vi?'Tra cứu nhà xe hoặc đơn vị vận tải đang phục vụ vào ngày đi; xác nhận tên trạm, chiều đi, chuyến cuối và đoạn đường còn lại tới cổng. Cẩm nang không xác nhận một tuyến xe buýt cụ thể.':'Check an operating provider for your travel date: confirm the stop name, direction, last departure and remaining route to the entrance. This guide does not verify a particular bus route.'}</p></article></div><p>{t.access}</p></section>}
{kind==='privacy'&&<section class="guide-section section-shell narrow"><h2>{vi?'Phân tích tùy chọn và dịch vụ lưu trữ':'Optional analytics and hosting'}</h2>{t.privacy.split(/(?=Cloudflare)/).map(part=><p>{part}</p>)}<p><a href="https://policies.google.com/privacy">Google privacy</a> · <a href="https://developers.cloudflare.com/web-analytics/data-metrics/">Cloudflare Web Analytics</a> · <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare privacy</a></p></section>}
{kind==='terms'&&<section class="guide-section section-shell narrow"><h2>{vi?'Phạm vi và giới hạn':'Scope and limits'}</h2><p>{t.independent}</p><p>{vi?'Thông tin có ngày đối chiếu, không phải cam kết hoạt động thời gian thực, an toàn, khả năng tiếp cận hay kết quả chuyến đi. Xác nhận trực tiếp với đơn vị vận hành; tuân thủ quy định tại chỗ.':'Information is dated and does not promise real-time availability, safety, accessibility or a travel outcome. Confirm directly with the operator and follow on-site instructions.'}</p></section>}
{faq.length>0&&<section class="guide-section soft"><div class="section-shell narrow"><h2>{vi?'Câu hỏi thường gặp':'Frequently asked questions'}</h2>{faq.map(x=><details class="guide-faq"><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></section>}
<section class="guide-section section-shell sources"><h2>{vi?'Nguồn và ngày đối chiếu':'Sources and review date'}</h2><p>{t.checked}</p><ul>{sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{clean(s[lang])} ↗</a></li>)}</ul></section></main><SiteFooter lang={lang}/></body></html>
