---
import {paths,type Kind} from '../data/guide';
interface Props {
  lang: 'vi' | 'en';
}
const { lang } = Astro.props;
const isVi = lang === 'vi';
const current=(Object.keys(paths) as Kind[]).find(k=>paths[k][lang]===Astro.url.pathname)||'home';

const t = {
  disclaimer: isVi
    ? 'Cẩm nang du lịch và phổ biến kiến thức độc lập, phi lợi nhuận, không phải website chính thức và không đại diện cho Khu du lịch Đại Nam. Hãy xác nhận giá vé, lịch hoạt động và quy định trực tiếp với đơn vị vận hành trước chuyến đi.'
    : 'An independent, nonprofit tourism and educational guide, not the official website and not affiliated with Khu du lịch Đại Nam. Please confirm ticket prices, opening hours and rules directly with the operator before your visit.',
  privacy: isVi ? 'Quyền riêng tư' : 'Privacy',
  terms: isVi ? 'Điều khoản' : 'Terms',
  cookieSettings: isVi ? 'Cài đặt cookie' : 'Cookie settings',
  langSwitch: isVi ? 'English' : 'Tiếng Việt',
  langHref: paths[current][isVi?'en':'vi'],
  trusted: isVi ? 'Nguồn tham khảo chính thức' : 'Official references',
  officialLabel: isVi ? 'Trang chủ Khu du lịch Đại Nam' : 'Khu du lịch Đại Nam (official)',
  tourismLabel: isVi ? 'Tổng cục Du lịch Việt Nam' : 'Vietnam National Authority of Tourism',
  provinceLabel: isVi ? 'Cổng du lịch Bình Dương (nhãn cũ)' : 'Binh Duong tourism portal (legacy label)',
  cookieTitle: isVi ? 'Quyền riêng tư & đo lường' : 'Privacy & measurement',
  cookieDesc: isVi
    ? 'Trang chỉ tải Google Analytics 4 sau khi bạn đồng ý cookie đo lường. Công tắc này chỉ kiểm soát GA, không kiểm soát phép đo độc lập của nền tảng.'
    : 'The site only loads Google Analytics 4 after you accept measurement cookies. This switch controls GA, not independent hosting measurement.',
  accept: isVi ? 'Đồng ý' : 'Accept',
  decline: isVi ? 'Từ chối' : 'Decline',
  cookiePanelTitle: isVi ? 'Tùy chọn đo lường' : 'Measurement options',
  cookiePanelDesc: isVi
    ? 'Giúp hiểu cách người dùng tương tác với trang. Chỉ bật khi bạn đồng ý.'
    : 'Helps understand how users interact with the page. Enabled only with your consent.',
  save: isVi ? 'Lưu lựa chọn' : 'Save preferences',
  cookieSettingsTitle: isVi ? 'Cài đặt cookie' : 'Cookie settings',
  photoCreditTitle: isVi ? 'Ghi công ảnh & nguồn' : 'Photo credits & sources',
};

const official = [
  { label: t.officialLabel, href: 'https://khudulichdainam.com.vn/' },
  { label: t.tourismLabel, href: 'https://vietnamtourism.gov.vn/' },
  { label: t.provinceLabel, href: 'https://tourism.binhduong.gov.vn/vi/khudulichdainam' },
];
---
<footer class="border-t border-white/10 bg-[#052f28] py-10 text-emerald-50/80">
  <div class="section-shell flex flex-col gap-6">
    <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
      <img src="/brand/logo.svg" alt={isVi?"Đại Nam — Cẩm nang tham quan":"Dai Nam — Visitor guide"} class="h-10 w-auto rounded-md bg-[#fffaf0] px-2 py-1" width="340" height="88" />
      <p class="max-w-2xl text-xs leading-5">{t.disclaimer}</p>
      <div class="flex flex-wrap gap-4 text-xs font-bold">
        <a class="underline underline-offset-4" href={isVi ? '/privacy/' : '/en/privacy/'}>{t.privacy}</a>
        <a class="underline underline-offset-4" href={isVi ? '/terms/' : '/en/terms/'}>{t.terms}</a>
        <button id="open-cookie-settings" class="text-left underline underline-offset-4">{t.cookieSettings}</button>
        <a class="underline underline-offset-4" href={t.langHref}>{t.langSwitch}</a>
      </div>
    </div>
    <div class="border-t border-white/10 pt-5">
      <p class="mb-2 text-[0.7rem] font-extrabold uppercase tracking-[.16em] text-[#f1c95f]">{t.trusted}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-xs">
        {official.map((o) => (
          <li><a class="underline underline-offset-4 hover:text-[#ffd66d]" href={o.href} target="_blank" rel="noreferrer noopener">{o.label}</a></li>
        ))}
      </ul>
    </div>
    <p class="text-xs leading-6"><a class="underline" href="https://commons.wikimedia.org/wiki/File:Voi_t%E1%BA%A1i_B%C3%ACnh_D%C6%B0%C6%A1ng.jpg">Bùi Thụy Đào Nguyên</a> · 2011-06-14 · <a class="underline" href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>. {isVi?'Ảnh voi lưu trữ, đã giảm kích thước/nén; ảnh mạng xã hội cắt thêm. Không xác nhận động vật hiện có hay chứng thực của tác giả.':'Historical elephant photo, resized/recompressed; social image additionally cropped. Not a current animal inventory or author endorsement.'}</p>
    <p class="text-[0.68rem] opacity-70">© {new Date().getFullYear()} Đại Nam — Cẩm nang tham quan · dainampark.com</p>
  </div>
</footer>

<div id="cookie-banner" class="cookie-panel fixed inset-x-3 bottom-3 z-[70] mx-auto max-w-3xl rounded-2xl border border-emerald-900/15 bg-[#fffdf7] p-5 shadow-2xl" hidden>
  <div class="sm:flex sm:items-center sm:justify-between sm:gap-6">
    <div><p class="font-bold">{t.cookieTitle}</p><p class="mt-1 text-sm leading-5 text-slate-600">{t.cookieDesc}</p></div>
    <p id="cookie-error" hidden role="status" class="mt-3 text-sm text-red-800">{isVi?"Không xác nhận được việc lưu lựa chọn. Phân tích đã tắt trên trang này; quyền đã ghi, kể cả từ lần thử thất bại này, có thể còn dùng ở tab khác hoặc lần tải lại nếu trình duyệt không lưu chặn theo tab. Không báo là đã lưu.":"Saving your choice could not be verified. Analytics is off on this page; a stored grant, including one written by this failed attempt, may remain usable in another tab or after reload if the tab veto could not be saved. This is not reported as saved."}</p><div class="mt-4 flex shrink-0 gap-2 sm:mt-0"><button id="cookie-decline" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-bold">{t.decline}</button><button id="cookie-accept" class="rounded-full bg-[#0e6a58] px-4 py-2 text-sm font-bold text-white">{t.accept}</button></div>
  </div>
</div>

<div id="cookie-settings" class="cookie-panel fixed inset-0 z-[80] grid place-items-center bg-black/45 p-4" hidden>
  <div class="w-full max-w-lg rounded-[1.6rem] bg-[#fffdf7] p-6 shadow-2xl">
    <div class="flex items-start justify-between gap-5"><div><p class="kicker">Cookie</p><h2 class="mt-2 text-3xl font-bold">{t.cookiePanelTitle}</h2></div><button id="cookie-close" class="text-2xl" aria-label={isVi?"Đóng cài đặt":"Close settings"}>×</button></div>
    <div class="mt-6 flex items-center justify-between gap-5 rounded-2xl bg-[#e9f2ee] p-4"><div><b>Google Analytics 4</b><p class="mt-1 text-xs leading-5 text-slate-600">{t.cookiePanelDesc}</p></div><input id="analytics-toggle" aria-label={isVi?"Bật Google Analytics":"Enable Google Analytics"} type="checkbox" class="h-5 w-5 accent-[#0e6a58]" /></div>
    <p id="cookie-settings-error" hidden role="status" class="mt-3 text-sm text-red-800">{isVi?"Không xác nhận được việc lưu lựa chọn. Phân tích đã tắt trên trang này; quyền đã ghi, kể cả từ lần thử thất bại này, có thể còn dùng ở tab khác hoặc lần tải lại nếu trình duyệt không lưu chặn theo tab. Không báo là đã lưu.":"Saving your choice could not be verified. Analytics is off on this page; a stored grant, including one written by this failed attempt, may remain usable in another tab or after reload if the tab veto could not be saved. This is not reported as saved."}</p>
    <button id="cookie-save" class="mt-5 w-full rounded-full bg-[#0e6a58] px-4 py-3 font-bold text-white">{t.save}</button>
  </div>
</div>

<script is:inline>
(()=>{
const KEY='daiNamAnalyticsConsent',VETO=KEY+'-tab-veto',GA='G-HXM22WWPKP';
const banner=document.getElementById('cookie-banner'),settings=document.getElementById('cookie-settings'),toggle=document.getElementById('analytics-toggle'),errors=[document.getElementById('cookie-error'),document.getElementById('cookie-settings-error')];let started=false,enabled=false;
const read=(store,key)=>{try{return{ok:true,value:store.getItem(key)}}catch{return{ok:false,value:null}}};
const local=()=>{try{return localStorage}catch{return null}},session=()=>{try{return sessionStorage}catch{return null}};
const verified=(store,key,value)=>{try{if(value===null)store.removeItem(key);else store.setItem(key,value);const r=read(store,key);return r.ok&&r.value===value}catch{return false}};
const state=()=>{const a=read(local(),KEY),b=read(session(),VETO);return{ok:a.ok&&b.ok,grant:a.ok&&b.ok&&a.value==='granted'&&b.value!=='denied',denied:a.ok&&b.ok&&(a.value==='denied'||b.value==='denied')}};
const error=(show)=>{for(const el of errors)if(el)el.hidden=!show;};
const off=()=>{enabled=false;window['ga-disable-'+GA]=true;if(typeof window.gtag==='function')window.gtag('consent','update',{analytics_storage:'denied'});if(toggle)toggle.checked=false;};
const erase=()=>{try{for(const item of document.cookie.split(';')){const n=item.trim().split('=')[0];if(!/^_ga(?:_|$)|^_gid$|^_gat/.test(n))continue;for(const d of['',location.hostname,'.'+location.hostname,'.dainampark.com'])document.cookie=n+'=; Max-Age=0; Path=/'+(d?'; Domain='+d:'')+'; SameSite=Lax';}}catch{}};
const denyShared=()=>verified(local(),KEY,'denied')||verified(local(),KEY,null);
const failed=()=>{off();verified(session(),VETO,'denied');denyShared();if(banner)banner.hidden=false;error(true);};
const load=()=>{enabled=true;window['ga-disable-'+GA]=false;window.dataLayer=window.dataLayer||[];if(typeof window.gtag!=='function')window.gtag=function(){window.dataLayer.push(arguments)};window.gtag('consent','update',{analytics_storage:'granted'});if(toggle)toggle.checked=true;if(started||document.querySelector('script[data-consent-loaded]')){started=true;return;}const el=document.createElement('script');el.async=true;el.src='https://www.googletagmanager.com/gtag/js?id='+GA;el.dataset.consentLoaded='true';window.gtag('js',new Date());window.gtag('config',GA);document.head.appendChild(el);started=true;};
const success=()=>{error(false);if(banner)banner.hidden=true;if(settings)settings.hidden=true;};
const grant=()=>{off();if(!verified(session(),VETO,null)||!verified(local(),KEY,'granted')||!state().grant){failed();return;}load();success();};
const deny=()=>{off();const veto=verified(session(),VETO,'denied'),saved=denyShared();erase();if(!veto||!saved){if(banner)banner.hidden=false;error(true);return;}success();};
const initial=state();if(initial.grant){load();if(banner)banner.hidden=true;}else{off();if(banner)banner.hidden=initial.denied;if(!initial.ok)error(true);}
document.getElementById('cookie-accept')?.addEventListener('click',grant);
document.getElementById('cookie-decline')?.addEventListener('click',deny);
document.getElementById('open-cookie-settings')?.addEventListener('click',()=>{if(toggle)toggle.checked=enabled;if(settings)settings.hidden=false;});
document.getElementById('cookie-close')?.addEventListener('click',()=>{if(toggle)toggle.checked=enabled;if(settings)settings.hidden=true;});
document.getElementById('cookie-save')?.addEventListener('click',()=>{if(toggle?.checked)grant();else deny();});
window.addEventListener('storage',event=>{if(event.key!==KEY&&event.key!==null)return;const x=state();if(!x.grant){off();if(!x.ok){if(banner)banner.hidden=false;error(true);}}});
})();
</script>
