---
import '../styles/global.css';
import BaseHead from './BaseHead.astro';
import SiteFooter from './SiteFooter.astro';
import {SITE, MAPS, OPERATOR, ADDRESS, CHECKED, sources, text, paths, labels, type Locale, type Kind} from '../data/guide';
import {linkFor, type Topic} from '../data/topics';

interface Props { topic: Topic; }
const { topic } = Astro.props;
const lang: Locale = 'vi';
const vi = true;
const t = text[lang];
const normalKinds: Kind[] = ['home','hours','tickets','directions'];

const canonical = SITE + '/' + topic.slug + '/';
const ogImage = topic.photos && topic.photos[0] ? SITE + topic.photos[0].src : SITE + '/images/elephant-social.jpg';
const imageAlt = topic.photos && topic.photos[0] ? topic.photos[0].alt : topic.h1;

const schema: Record<string, unknown>[] = [
  {'@context':'https://schema.org','@type':'TouristAttraction','@id':canonical+'#place','name':topic.h1,'description':topic.description,'address':{'@type':'PostalAddress','addressLocality':'Phường Phú An','addressRegion':'Thành phố Hồ Chí Minh','addressCountry':'VN'}},
  {'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Khu du lịch Đại Nam','item':SITE+'/'},{'@type':'ListItem','position':2,'name':topic.h1,'item':canonical}]},
];
const hreflangs = [{lang:'vi',href:canonical},{lang:'x-default',href:canonical}];

const related = (topic.related || []).map(linkFor).filter((x): x is {href:string;label:string} => x !== null);
---
<!doctype html><html lang="vi"><head>
<BaseHead lang="vi" title={topic.title} description={topic.description} canonical={canonical} ogImage={ogImage} imageAlt={imageAlt} schema={schema} hreflangs={hreflangs}/>
</head><body>
<a class="skip-link" href="#main">{t.menu}</a>
<header class="guide-header"><div class="section-shell header-row">
  <a href={paths.home[lang]}><img src="/brand/logo.svg" width="340" height="88" alt="Đại Nam — Cẩm nang tham quan"/></a>
  <nav class="desktop-nav" aria-label={t.menu}>{normalKinds.map(k=><a href={paths[k][lang]}>{labels[lang][k]}</a>)}</nav>
  <a class="language-link" href={paths.home.en} hreflang="en">English</a>
  <details class="guide-menu"><summary>{t.menu}</summary><nav aria-label={t.menu}>{normalKinds.map(k=><a href={paths[k][lang]}>{labels[lang][k]}</a>)}</nav></details>
</div></header>

<main id="main">
  <section class="guide-hero"><div class="section-shell">
    <p class="eyebrow">{topic.eyebrow ?? 'Khu du lịch Đại Nam'}</p>
    <h1>{topic.h1}</h1>
    <p>{topic.intro}</p>
    <div class="hero-actions">
      <a class="btn-primary" href={OPERATOR} target="_blank" rel="noopener noreferrer">{t.operator} ↗</a>
      <a class="btn-ghost" href={MAPS} target="_blank" rel="noopener noreferrer">Google Maps ↗</a>
    </div>
  </div></section>

  {topic.explore && <section class="guide-section section-shell"><h2>Khám phá</h2><p class="prose-vn">{topic.explore}</p></section>}

  {topic.tips && <section class="guide-section soft"><div class="section-shell narrow"><h2>Gợi ý tham quan</h2><p>{topic.tips}</p></div></section>}

  {topic.highlights && topic.highlights.length>0 && <section class="guide-section section-shell"><h2>Điểm nổi bật</h2><div class="info-cards">{topic.highlights.map(h=><article class="card"><h3>{h.title}</h3><p>{h.body}</p></article>)}</div></section>}

  {topic.about && <section class="guide-section section-shell narrow"><h2>Về điểm tham quan</h2><p>{topic.about}</p></section>}

  {topic.basic && <section class="guide-section section-shell narrow"><h2>Thông tin cơ bản</h2><p>{topic.basic}</p></section>}

  {topic.hours && <section class="guide-section section-shell narrow"><h2>Giờ mở cửa</h2><p>{topic.hours}</p><p class="illustration-note">{t.checked}</p></section>}

  {topic.tickets && <section class="guide-section section-shell narrow"><h2>Vé và chi phí</h2><p>{topic.tickets}</p></section>}

  {topic.directions && <section class="guide-section section-shell narrow"><h2>Đường đi</h2><p>{topic.directions}</p><p class="address-line">{ADDRESS}</p><div class="hero-actions"><a class="btn-ghost" href={MAPS} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a class="btn-ghost" href={paths.directions[lang]}>{labels[lang].directions} →</a></div></section>}

  {topic.discovery && <section class="guide-section section-shell"><h2>Khám phá thêm</h2><p class="prose-vn">{topic.discovery}</p></section>}

  {topic.route && topic.route.length>0 && <section class="guide-section soft"><div class="section-shell narrow"><h2>Lộ trình tham quan</h2><div>{topic.route.map(s=><div class="timeline-step"><h3>{s.title}</h3><p>{s.body}</p></div>)}</div></div></section>}

  {topic.notes && <section class="guide-section section-shell narrow"><h2>Lưu ý khi tham quan</h2><p>{topic.notes}</p></section>}

  {topic.photos && topic.photos.length>0 && <section class="guide-section section-shell"><h2>Góc chụp ảnh</h2><div class="restored-photos">{topic.photos.map(p=><figure><img src={p.src} width="1600" height="1200" alt={p.alt} loading="lazy"/><figcaption>{p.alt}{p.credit?(' · '+p.credit):''}</figcaption></figure>)}</div></section>}

  {topic.stay && <section class="guide-section section-shell narrow"><h2>Gợi ý lưu trú</h2><p>{topic.stay}</p></section>}

  <section class="guide-section soft"><div class="section-shell narrow"><h2>Đánh giá trên Maps</h2><p>{t.snapshot}</p></div></section>

  {topic.faq && topic.faq.length>0 && <section class="guide-section section-shell narrow"><h2>Câu hỏi thường gặp</h2>{topic.faq.map(x=><details class="guide-faq"><summary>{x.q}</summary><p>{x.a}</p></details>)}</section>}

  {related.length>0 && <section class="guide-section section-shell"><h2>Nội dung liên quan</h2><ul class="related-list">{related.map(r=><li><a href={r.href}>{r.label}</a></li>)}</ul></section>}

  <section class="guide-section section-shell sources"><h2>{t.checked}</h2><ul>{sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.vi} ↗</a></li>)}</ul></section>
</main>
<SiteFooter lang="vi"/>
</body></html>
