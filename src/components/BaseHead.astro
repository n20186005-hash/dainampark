---
interface Props {
  lang: 'vi' | 'en';
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  schema?: Record<string, unknown>[];
  hreflangs?: { lang: string; href: string }[];
}
const {
  lang,
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage,
  schema = [],
  hreflangs = [],
} = Astro.props;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#073f35" />
<title>{title}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
<meta property="og:type" content="website" />
<meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
{canonical && <meta property="og:url" content={canonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/brand/favicon-16.png" sizes="16x16" type="image/png" />
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)}></script>)}
